{
  "name": "criminal-record-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-both.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "install-all": "npm --prefix server install && npm --prefix client install",
    "build": "cd client && npm install --include=dev && npx tsc && npx vite build",
    "setup:db": "mysql -u root -p < db/schema.sql && mysql -u root -p < db/seed.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^22.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "vite": "^5.4.2"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.5"
  }
}
